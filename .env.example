# Safe local-development values.
# The API reads process environment variables; it does not automatically load .env.
# For local Uvicorn: uvicorn api.main:app --reload --env-file .env

CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RUNTIME_STATE_DB=api/interventions.sqlite3

# Optional reviewed immutable ML bundle. Blank preserves labelled legacy demo.
# Build explicitly into a NEW directory first; never use a downloaded/untrusted pickle.
GRAVITY_ML_BUNDLE=

# Phase 1 foundations only: the current API still uses RUNTIME_STATE_DB above.
# Do not point DATABASE_URL at an existing/legacy database. No automatic migration.
# Create the parent directory explicitly before setting up a NEW local database.
GRAVITY_MODE=local
DATABASE_URL=sqlite:///data/runtime/gravity-demo-v2.sqlite3
# Shared deployment requires GRAVITY_MODE=shared and a privately supplied
# postgresql+psycopg connection URL. Never put its real credentials in this file.

# Used by the Docker startup command.
# Local Uvicorn requires --port explicitly.
PORT=8000
